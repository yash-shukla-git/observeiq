# Copy to .env.local. Next.js loads it for the dashboard only.

# Public URL of the collector, exposed to the browser
NEXT_PUBLIC_COLLECTOR_URL=http://localhost:4318

# Same database the worker writes to. Logins are stored in its users table (npm run migrate creates it).
DATABASE_URL=postgres://observeiq:observeiq@localhost:5432/observeiq
# true for Neon, false for local Postgres
DATABASE_SSL=false

# Signs the session cookie. At least 32 characters. Generate with: openssl rand -base64 32
SESSION_SECRET=

# Set to false to close signup after you created your account
ALLOW_SIGNUP=true

# AI analysis on the trace page. Server side only, never put these in NEXT_PUBLIC_ variables.
# Without a key the panel still shows the detector findings and the Analyze button is disabled.
# AI_PROVIDER: gemini, ollama or none (left out: gemini if GEMINI_API_KEY is set)
AI_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=
AI_MAX_CALLS_PER_MINUTE=5
AI_DAILY_LIMIT=100
AI_TIMEOUT_MS=20000
