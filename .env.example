# Postgres
# Individual fields are provided for local psql access; the app itself
# connects using DATABASE_URL.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=observeiq
DB_USER=observeiq
DB_PASSWORD=change-me

# Full connection string used by the collector and worker (pg Pool).
# Matches DB_* above for local Docker Postgres, or point it at Neon in prod.
DATABASE_URL=postgres://observeiq:change-me@localhost:5432/observeiq

# RabbitMQ
# Local: amqp://guest:guest@localhost:5672
# CloudAMQP (prod): amqps://<user>:<password>@<host>/<vhost>
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Collector
PORT=4318
COLLECTOR_URL=http://localhost:4318

# Queue
QUEUE_NAME=spans

# Auth (reserved for dashboard session signing; not yet wired up)
SESSION_SECRET=change-me

# Demo app (order/inventory/payment services)
ORDER_PORT=3001
INVENTORY_PORT=3002
PAYMENT_PORT=3003
INVENTORY_URL=http://localhost:3002
PAYMENT_URL=http://localhost:3003
