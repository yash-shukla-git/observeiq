# Postgres
# Local (docker compose): postgres://observeiq:observeiq@localhost:5432/observeiq
# Neon (prod): copy the pooled connection string from the Neon dashboard
DATABASE_URL=postgres://observeiq:observeiq@localhost:5432/observeiq
# true for Neon, false for local Postgres
DATABASE_SSL=false

# RabbitMQ
# Local: amqp://guest:guest@localhost:5672
# CloudAMQP (prod): amqps://<user>:<password>@<host>/<vhost>
RABBITMQ_URL=amqp://guest:guest@localhost:5672
QUEUE_NAME=spans

# Collector
# Not PORT: Next.js also reads PORT and would try to bind the same port.
COLLECTOR_PORT=4318
COLLECTOR_URL=http://localhost:4318
# Shared key the SDK sends as x-api-key. Empty means ingest is open (fine locally).
# Use the same value for the collector and every service that uses the SDK.
INGEST_API_KEY=
# Dashboard origin allowed to call the collector from the browser (production only)
# CORS_ORIGIN=https://your-dashboard.example.com

# Demo app (order/inventory/payment services)
ORDER_PORT=3001
INVENTORY_PORT=3002
PAYMENT_PORT=3003
INVENTORY_URL=http://localhost:3002
PAYMENT_URL=http://localhost:3003
ORDER_URL=http://localhost:3001
# Lets the demo services accept POST /__fault (used by npm run eval). Never true in production.
ENABLE_FAULTS=false

# The dashboard reads its own file, see apps/dashboard/.env.example
# (it needs DATABASE_URL, SESSION_SECRET and NEXT_PUBLIC_COLLECTOR_URL)
