{
  "name": "observeiq",
  "private": true,
  "workspaces": [
    "apps/*",
    "apps/demo-app/*",
    "packages/*"
  ],
  "scripts": {
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "payment": "tsx apps/demo-app/payment-service/src/index.ts",
    "inventory": "tsx apps/demo-app/inventory-service/src/index.ts",
    "order": "tsx apps/demo-app/order-service/src/index.ts",
    "collector": "tsx apps/collector/src/index.ts",
    "worker": "tsx apps/worker/src/index.ts",
    "migrate": "tsx scripts/migrate.ts",
    "build:sdk": "npm run build --workspace=@yashshukla/observeiq-node"
  },
  "type": "module",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.20.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "pg": "^8.21.0"
  },
  "version": "0.0.1"
}
